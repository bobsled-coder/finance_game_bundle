# The default build contexts are pinned by release-pair.json.
# To use local sibling checkouts, set these to ../finance_game_go and
# ../finance_game_ui respectively, then use `just up` to record their actual
# Git SHAs and mark the deployment as a local override.
# GO_SOURCE=../finance_game_go
# UI_SOURCE=../finance_game_ui

# Local stack settings. Change the password before exposing the stack.
POSTGRES_PASSWORD=financegame_local_dev
BIND_ADDRESS=127.0.0.1
UI_PORT=3000
